# Nginx configuration for Future Gas ERP (Frontend + Backend)
# Replace 'yourdomain.com' with your actual domain or VPS IP address

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;

    # Client upload size limit for invoice PDFs and receipts
    client_max_body_size 50M;

    # 1. Frontend React Single-Page Application (SPA)
    location / {
        root /var/www/futuregas/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # 2. Django Backend API
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # 3. Django Static Files (Swagger/Redoc/Admin if needed)
    location /static/ {
        alias /var/www/futuregas/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }
}
