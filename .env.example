# ==============================================================
# Royal Agencies - Production Environment Variables
# Location on VPS: /var/www/royalagencies/.env
# ==============================================================

# Security
SECRET_KEY=generate-a-strong-random-50-character-key
DEBUG=False
ALLOWED_HOSTS=api.royalagencies.online,royalagencies.online,179.197.242.241,127.0.0.1,localhost

# PostgreSQL Database (Hostinger VPS)
DB_NAME=routeflow_db
DB_USER=royal_user
DB_PASSWORD=your_strong_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS & CSRF Origins (Include both main domain and api subdomain)
CORS_ALLOWED_ORIGINS=https://royalagencies.online,https://api.royalagencies.online
CSRF_TRUSTED_ORIGINS=https://royalagencies.online,https://api.royalagencies.online
